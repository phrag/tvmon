<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Floating overlay. NOT a root permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only for the optional "start overlay on boot" toggle. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wi-Fi tile: link speed/frequency (no location perm needed for these fields). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Latency tile: pings the gateway + a public resolver. Opt-in (off by
         default) and only probes while that tile is enabled. Also the
         self-updater's version check, once each time the settings open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update from the GitHub release (Updater.kt). Android 11 and older always ask to confirm; 12+ can skip that for updates. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Declare a no-touch TV app so the leanback launcher accepts it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="tvmon"
        android:allowBackup="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <!-- Android TV home screen entry.
                 NOTE: stock launchers also want android:banner="@drawable/banner"
                 (320x180) or the tile may be hidden; until then launch with
                 adb shell am start -n com.phrag.tvmon/.SettingsActivity -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller status for self-updates. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
