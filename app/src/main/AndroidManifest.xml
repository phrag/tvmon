<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Privacy: deliberately NO android.permission.INTERNET. The app cannot open a
         socket, so nothing it reads can leave the box. Updates are installed by hand. -->

    <!-- Floating overlay. NOT a root permission. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only for the optional "start overlay on boot" toggle. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- OverlayService runs in the foreground so the system keeps it alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Only to show the "overlay is on" notification on Android 13+; the service runs without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Network tiles: transport, VPN, validated/metered, addresses, DNS. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Wi-Fi band/channel, link rate and RSSI. No location permission: SSID isn't shown. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Declare a no-touch TV app so the leanback launcher accepts it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- ACCESS_WIFI_STATE would otherwise imply Wi-Fi is required; Ethernet-only TVs are fine. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- No backups: allowBackup="false" covers API 26-30 entirely; on 12+ it only
         covers cloud backup, so the rules file also blocks device-to-device transfer. -->
    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Always-on-top system and network status overlay the user turns on; it must keep running while other apps are in the foreground." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
